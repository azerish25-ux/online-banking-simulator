<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level [%thread] [%X{traceId:-none}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="com.bank.platform" level="INFO"/>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
